<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="15dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_page_title"
                android:fontFamily="@font/misans"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/about_subtitle"
                android:fontFamily="@font/misans"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_background"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_authors_title"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.microsoft.xbox.idp.toolkit.CircleImageView
                        android:id="@+id/author_avatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_qa_account"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_author_name"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_surface"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/author_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="18dp"
                                android:layout_marginStart="8dp"
                                android:paddingHorizontal="8dp"
                                android:gravity="center"
                                android:text="@string/about_author_badge"
                                android:fontFamily="@font/misans"
                                android:textColor="@color/on_primary"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_author_badge" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/about_author_role"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- First Row of Links -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_taplink"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:paddingHorizontal="14dp"
                        android:gravity="center"
                        android:text="Taplink"
                        android:fontFamily="@font/misans"
                        android:textColor="#2196F3"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_link_chip_blue"
                        android:drawableStart="@drawable/ic_link"
                        android:drawablePadding="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_guns"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="14dp"
                        android:gravity="center"
                        android:text="Guns.gg"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_link_chip_blue"
                        android:drawableStart="@drawable/ic_globe"
                        android:drawablePadding="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_github_repo"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="14dp"
                        android:gravity="center"
                        android:text="GitHub"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_link_chip_blue"
                        android:drawableStart="@drawable/ic_github"
                        android:drawablePadding="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Second Row of Links -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_patreon"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:paddingHorizontal="14dp"
                        android:gravity="center"
                        android:text="@string/about_patreon"
                        android:fontFamily="@font/misans"
                        android:textColor="#FF9800"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_link_chip_orange"
                        android:drawableStart="@drawable/ic_patreon"
                        android:drawablePadding="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_youtube_main"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="14dp"
                        android:gravity="center"
                        android:text="YouTube"
                        android:fontFamily="@font/misans"
                        android:textColor="#FF0000"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_link_chip_pink"
                        android:drawableStart="@drawable/ic_youtube"
                        android:drawablePadding="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btn_youtube_rbx"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="14dp"
                        android:gravity="center"
                        android:text="BiniRBX"
                        android:fontFamily="@font/misans"
                        android:textColor="#FF0000"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_link_chip_pink"
                        android:drawableStart="@drawable/ic_youtube"
                        android:drawablePadding="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Third Row of Links -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_youtube_fx"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:paddingHorizontal="14dp"
                        android:gravity="center"
                        android:text="BiniFx"
                        android:fontFamily="@font/misans"
                        android:textColor="#FF0000"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_link_chip_pink"
                        android:drawableStart="@drawable/ic_youtube"
                        android:drawablePadding="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/divider"
                    android:alpha="0.3" />

                <LinearLayout
                    android:id="@+id/btn_open_storage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_content"
                        app:tint="@color/on_surface" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Open Data Folder"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Access Minecraft worlds and resource packs"
                            android:fontFamily="@font/misans"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/text_secondary"
                        android:textSize="18sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
